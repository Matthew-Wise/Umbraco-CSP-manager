# Umbraco CLI (@umbraco-cms/mcp-dev) connection for the uSync test site B (src/uSync/uSync.TestSiteB).
# Copy to .env.usync-b in the repo root (gitignored) and fill in the secret.
# The API user must exist in this site's backoffice (Users > API users).
UMBRACO_CLIENT_ID=umbraco-back-office-mcp
UMBRACO_CLIENT_SECRET=<api-user-client-secret>
UMBRACO_BASE_URL=https://localhost:44382
# Accept the site's self-signed dev certificate. Only valid for localhost URLs.
NODE_TLS_REJECT_UNAUTHORIZED=0
